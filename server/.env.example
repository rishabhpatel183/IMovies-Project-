PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
HOLD_MINUTES=5
ADMIN_EMAIL=admin@imovies.com

# Razorpay Payment Gateway (Optional - defaults to mock test mode if empty)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP Email Dispatch (Optional - defaults to simulated mailer if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="iMovies Cinemas" <tickets@imovies.com>
